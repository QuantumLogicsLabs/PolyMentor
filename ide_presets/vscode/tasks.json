{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PolyMentor: Analyze Active File (LSP Diagnostics)",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "${workspaceFolder}/scripts/ide_bridge.py",
                "--file",
                "${file}",
                "--format",
                "lsp"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true
            },
            "problemMatcher": []
        },
        {
            "label": "PolyMentor: Batch Workspace Review & Quality Gate",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": [
                "${workspaceFolder}/scripts/ide_bridge.py",
                "--dir",
                "${workspaceFolder}/src",
                "--format",
                "lsp",
                "--min-score",
                "75"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            },
            "problemMatcher": []
        }
    ]
}
