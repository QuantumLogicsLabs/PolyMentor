GROQ_API_KEY=Your_groq_api_key          
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
ASSISTANT_RATE_LIMIT_MAX=20


MONGODB_USER=your_username
MONGODB_PASSWORD=your_password
MONGODB_CLUSTER=your_cluster
MONGODB_DB=polycode
MONGODB_COLLECTION=prompts
# Optional full URI. Preferred for GitHub Actions secrets.
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster/?retryWrites=true&w=majority